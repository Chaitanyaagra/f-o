# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env to git.  Add ".env" to your .gitignore.

# --- Angel One / SmartAPI credentials (kept server-side only) ---
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_CODE=your_client_code
# Use your login MPIN/password here:
ANGEL_MPIN=your_mpin_or_password
# The BASE32 TOTP secret from Angel One's 2FA setup (the seed, not the 6-digit code):
ANGEL_TOTP_SECRET=your_totp_base32_secret

# --- Safety ---
# Leave this "true" until you have tested end-to-end. Orders are simulated while true.
DRY_RUN=true

# --- Networking ---
HOST=127.0.0.1
PORT=8000
# Origins allowed to call this backend from a browser (comma-separated).
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000
